{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terra-analog:catalog-response:1.0.0",
  "title": "CatalogResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "catalog_version", "generated_at", "is_synthetic", "datasets", "features", "profiles", "search_regions", "warnings", "limitations"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "is_synthetic": {"type": "boolean"},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "search_regions": {"type": "array", "items": {"$ref": "#/$defs/searchRegion"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "linearRing": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "polygonCoordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/linearRing"}},
    "multiPolygonCoordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/polygonCoordinates"}},
    "geometry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"$ref": "#/$defs/polygonCoordinates"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiPolygon"}, "coordinates": {"$ref": "#/$defs/multiPolygonCoordinates"}}}
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["SYNTHETIC_DATA", "TOPOGRAPHY_ONLY", "REGIONAL_COVERAGE", "COARSE_RESOLUTION", "PROXY_FEATURE", "NO_ELIGIBLE_PIXELS"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "role", "body", "grid_version", "model_version", "availability", "coverage_description", "manifest_path"],
      "properties": {
        "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"enum": ["earth_search", "planetary_reference", "validation", "fixture_only"]},
        "body": {"enum": ["earth", "mars", "moon"]},
        "grid_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "model_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "availability": {"enum": ["available", "planned", "unavailable", "synthetic_only"]},
        "coverage_description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "manifest_path": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "name", "description", "unit", "measurement_scale", "domain_id", "domain_label", "availability", "is_proxy", "proxy_description", "source_ids"],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "measurement_scale": {"enum": ["ratio", "interval", "ordinal", "nominal"]},
        "domain_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "domain_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "availability": {"enum": ["available", "planned", "unavailable", "synthetic_only"]},
        "is_proxy": {"type": "boolean"},
        "proxy_description": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "name", "body", "region_name", "profile_version", "availability", "feature_ids", "source_ids"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "body": {"enum": ["mars", "moon"]},
        "region_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "availability": {"enum": ["available", "planned", "unavailable", "synthetic_only"]},
        "feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "searchRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "name", "dataset_version", "availability", "geometry", "mask_id", "description"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "availability": {"enum": ["available", "planned", "unavailable", "synthetic_only"]},
        "geometry": {"$ref": "#/$defs/geometry"},
        "mask_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
