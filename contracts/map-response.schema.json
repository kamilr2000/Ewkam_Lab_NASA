{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terra-analog:map-response:1.0.0",
  "title": "MapResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dataset_version", "grid_version", "model_version", "profile_version", "analysis_id", "is_synthetic", "query", "map_cells", "next_cursor"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "grid_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysis_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "is_synthetic": {"type": "boolean"},
    "query": {"$ref": "#/$defs/query"},
    "map_cells": {"type": "array", "items": {"$ref": "#/$defs/mapCell"}},
    "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "linearRing": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/linearRing"}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {"type": {"const": "MultiPolygon"}, "coordinates": {"type": "array", "minItems": 1}}
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox", "level", "limit"],
      "properties": {
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90},
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "level": {"type": "integer", "minimum": 0, "maximum": 30},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "mapCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "level", "geometry", "max_score_pct", "mean_score_pct", "max_pixel_id", "valid_pixel_count", "total_pixel_count", "coverage_fraction", "missing_reason"],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "level": {"type": "integer", "minimum": 0, "maximum": 30},
        "geometry": {"$ref": "#/$defs/geometry"},
        "max_score_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mean_score_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "max_pixel_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "valid_pixel_count": {"type": "integer", "minimum": 0},
        "total_pixel_count": {"type": "integer", "minimum": 0},
        "coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_reason": {"type": ["string", "null"], "enum": ["missing_feature_value", "outside_scope", "no_eligible_pixels", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"valid_pixel_count": {"const": 0}}},
          "then": {"properties": {"max_score_pct": {"type": "null"}, "mean_score_pct": {"type": "null"}, "max_pixel_id": {"type": "null"}, "missing_reason": {"type": "string"}}}
        },
        {
          "if": {"properties": {"valid_pixel_count": {"minimum": 1}}},
          "then": {"properties": {"max_score_pct": {"type": "number"}, "mean_score_pct": {"type": "number"}, "max_pixel_id": {"type": "string"}, "missing_reason": {"type": "null"}}}
        }
      ]
    }
  }
}
