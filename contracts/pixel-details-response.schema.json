{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terra-analog:pixel-details-response:1.0.0",
  "title": "PixelDetailsResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dataset_version", "grid_version", "model_version", "profile_version", "analysis_id", "is_synthetic", "result_mode", "pixel"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "grid_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysis_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "is_synthetic": {"type": "boolean"},
    "result_mode": {"enum": ["pixels", "distinct_areas"]},
    "pixel": {"$ref": "#/$defs/pixel"}
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "linearRing": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/linearRing"}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {"type": {"const": "MultiPolygon"}, "coordinates": {"type": "array", "minItems": 1}}
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "value", "unit", "measurement_scale", "similarity_pct", "normalized_weight", "contribution_pct", "reference_interval", "tolerance", "source_ids", "missing_reason"],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "measurement_scale": {"enum": ["ratio", "interval", "ordinal", "nominal"]},
        "similarity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "normalized_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "contribution_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "reference_interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "missing_reason": {"type": ["string", "null"], "enum": ["missing_feature_value", "source_nodata", "failed_quality", "unsupported_resolution", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"value": {"type": "null"}}},
          "then": {"properties": {"similarity_pct": {"type": "null"}, "contribution_pct": {"type": "null"}, "missing_reason": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"similarity_pct": {"type": "number"}, "contribution_pct": {"type": "number"}, "missing_reason": {"type": "null"}}}
        }
      ]
    },
    "pixel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pixel_id", "score_pct", "center", "geometry", "pixel_area_km2", "coverage_fraction", "features", "quality_flags", "missing_reasons"],
      "properties": {
        "pixel_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "score_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "center": {"$ref": "#/$defs/position"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "pixel_area_km2": {"type": "number", "exclusiveMinimum": 0},
        "coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "features": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/feature"}},
        "quality_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["LOW_COVERAGE", "INTERPOLATED", "SOURCE_EDGE", "SYNTHETIC_FIXTURE"]}},
        "missing_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["missing_feature_value", "source_nodata", "failed_quality", "unsupported_resolution"]}}
      },
      "allOf": [
        {
          "if": {"properties": {"score_pct": {"type": "null"}}},
          "then": {"properties": {"missing_reasons": {"minItems": 1}}},
          "else": {"properties": {"missing_reasons": {"maxItems": 0}}}
        }
      ]
    }
  }
}
