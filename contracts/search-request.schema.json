{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terra-analog:search-request:1.0.0",
  "title": "SearchRequest v1",
  "description": "A version-pinned request. feature_id values must also be unique; catalog compatibility is checked semantically by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "body",
    "profile_id",
    "dataset_version",
    "scope",
    "criteria",
    "result_mode",
    "top_k"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "body": {"enum": ["mars", "moon"]},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "global"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "region_id"],
          "properties": {
            "type": {"const": "regional"},
            "region_id": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "weight"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}
        }
      }
    },
    "result_mode": {"enum": ["pixels", "distinct_areas"]},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
    "min_distance_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"result_mode": {"const": "distinct_areas"}}},
      "then": {"required": ["min_distance_km"]}
    },
    {
      "if": {"properties": {"result_mode": {"const": "pixels"}}},
      "then": {"not": {"required": ["min_distance_km"]}}
    }
  ]
}
