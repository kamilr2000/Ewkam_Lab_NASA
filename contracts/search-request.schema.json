{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terra-analog:search-request:0.1",
  "title": "SearchRequest — planning draft 0.1",
  "description": "AI-assisted initial contract. Semantic validation against the versioned catalog is also required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "profile_id", "dataset_version", "criteria", "result_mode", "top_k"],
  "properties": {
    "body": {"enum": ["mars", "moon"]},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "weight"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}
        }
      }
    },
    "result_mode": {"enum": ["pixels", "distinct_areas"]},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
    "min_distance_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"result_mode": {"const": "distinct_areas"}}},
      "then": {"required": ["min_distance_km"]}
    }
  ]
}
