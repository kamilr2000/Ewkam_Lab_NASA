        "id": "roughness_m",
        "unit": "m"
      },
      {
        "id": "relief_m",
        "unit": "m"
      }
    ],
    "vertical_reference_target": "EGM2008 geoid height",
    "vertical_transformation": {
      "source": "NASADEM_HGT heights relative to EGM96 geoid",
      "target": "ETOPO 2022 heights relative to EGM2008 geoid",
      "method": "PROJ vertical operation using the NGA EGM96 and EGM2008 geoid grids; do not compare raw absolute heights.",
      "operation_name": "Inverse of WGS 84 to EGM96 height (1) + WGS 84 to EGM2008 height (1)",
      "operation_accuracy_m": 1.113,
      "operation_definition": "proj=pipeline step proj=unitconvert xy_in=deg xy_out=rad step proj=vgridshift grids=us_nga_egm96_15.tif multiplier=1 step inv proj=vgridshift grids=us_nga_egm08_25.tif multiplier=1 step proj=unitconvert xy_in=rad xy_out=deg",
      "grid_files": [
        "us_nga_egm96_15.tif",
        "us_nga_egm08_25.tif"
